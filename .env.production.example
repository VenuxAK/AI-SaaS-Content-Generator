# ==============================================================================
# Production Environment Configuration (Cloudflare + Docker + Octane)
# ==============================================================================
APP_NAME="AI SaaS Content Generator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database Configuration (Docker MySQL Service)
# ------------------------------------------------------------------------------
# Option A: Standalone Cloud Database URL (TiDB Cloud Serverless, AWS RDS, etc.)
# If DB_URL is set, it overrides DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# DB_URL="mysql://<username>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/saas_content_generator?ssl-mode=REQUIRED"

# Option B: Individual Service Credentials (or Docker Compose MySQL service)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=saas_content_generator
DB_USERNAME=content_user
DB_PASSWORD=replace_with_strong_password
DB_ROOT_PASSWORD=replace_with_strong_root_password

# Optional Host Port Forwarding (for local debugging/backups only)
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Redis, Cache, Sessions, & Queue
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=saas_content_generator_cache

# ------------------------------------------------------------------------------
# Laravel Octane (FrankenPHP)
# ------------------------------------------------------------------------------
OCTANE_SERVER=frankenphp
OCTANE_MAX_REQUESTS=1000
OCTANE_HTTPS=true
APP_PORT=8000

# ------------------------------------------------------------------------------
# Mail Settings (Optional)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Stripe Billing (Optional)
# ------------------------------------------------------------------------------
BILLING_DRIVER=mock
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
